// std/env — Environment variable utilities for Vyr

/// Gets an environment variable, returning default_val if unset.
fn env_or(name, default_val) {
  let val = get_env(name)
  if val == "" { default_val } else { val }
}

/// Gets a required environment variable. Returns Err if unset.
fn require_env(name) {
  let val = get_env(name)
  if val == "" {
    err("missing required env var: " + name)
  } else {
    ok(val)
  }
}

/// Returns true if an environment variable is set (non-empty).
fn has_env(name) {
  get_env(name) != ""
}

/// Returns the HOME directory.
fn home_dir() {
  get_env("HOME")
}

/// Returns the PATH as a list of directories.
fn path_dirs() {
  get_env("PATH") |> split(":")
}

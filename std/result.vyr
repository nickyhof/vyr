// std/result — Result type utilities for Vyr

/// Maps f over the Ok value, leaving Err unchanged.
fn map_ok(result, f) {
  if is_ok(result) {
    let val = unwrap(result)
    ok(val |> f)
  } else {
    result
  }
}

/// Maps f over the Err value, leaving Ok unchanged.
fn map_err(result, f) {
  if is_err(result) {
    let val = unwrap_err(result)
    err(val |> f)
  } else {
    result
  }
}

/// Chains a function that returns a Result on the Ok value.
fn and_then(result, f) {
  if is_ok(result) {
    let val = unwrap(result)
    val |> f
  } else {
    result
  }
}

/// Calls f with the result if it is Err, otherwise returns Ok.
fn or_else(result, f) {
  if is_err(result) {
    f(result)
  } else {
    result
  }
}

/// Flattens a nested Result (Ok(Ok(x)) becomes Ok(x)).
fn flatten_result(result) {
  if is_ok(result) {
    unwrap(result)
  } else {
    result
  }
}

/// Collects a list of Results into a Result of a list.
/// Returns Err on the first error found.
fn collect_results(xs) {
  let mut values = []
  let mut i = 0
  while i < length(xs) {
    let r = index(xs, i)
    if is_err(r) { return r }
    values = push(values, unwrap(r))
    i = i + 1
  }
  ok(values)
}

/// Runs side-effect f on the Ok value, returns original result.
fn tap_ok(result, f) {
  if is_ok(result) {
    f(unwrap(result))
  }
  result
}

/// Runs side-effect f on the Err value, returns original result.
fn tap_err(result, f) {
  if is_err(result) {
    f(unwrap_err(result))
  }
  result
}

/// Converts a Result to a human-readable string.
fn result_to_string(result) {
  if is_ok(result) {
    "Ok(" + to_string(unwrap(result)) + ")"
  } else {
    "Err(" + to_string(unwrap_err(result)) + ")"
  }
}

// std/result — Result type utilities for Vyr
// Higher-order operations for composing Ok/Err pipelines.

fn map_ok(result, f) {
  if is_ok(result) {
    let val = unwrap(result)
    ok(val |> f)
  } else {
    result
  }
}

fn map_err(result, f) {
  if is_err(result) {
    let val = unwrap_err(result)
    err(val |> f)
  } else {
    result
  }
}

fn and_then(result, f) {
  if is_ok(result) {
    let val = unwrap(result)
    val |> f
  } else {
    result
  }
}

fn or_else(result, f) {
  if is_err(result) {
    f(result)
  } else {
    result
  }
}

fn flatten_result(result) {
  if is_ok(result) {
    unwrap(result)
  } else {
    result
  }
}

fn collect_results(xs) {
  let mut values = []
  let mut i = 0
  while i < length(xs) {
    let r = index(xs, i)
    if is_err(r) { return r }
    values = push(values, unwrap(r))
    i = i + 1
  }
  ok(values)
}

fn tap_ok(result, f) {
  if is_ok(result) {
    f(unwrap(result))
  }
  result
}

fn tap_err(result, f) {
  if is_err(result) {
    f(unwrap_err(result))
  }
  result
}

fn result_to_string(result) {
  if is_ok(result) {
    "Ok(" + to_string(unwrap(result)) + ")"
  } else {
    "Err(" + to_string(unwrap_err(result)) + ")"
  }
}

// std/math — Math utilities for Vyr

/// Returns the absolute value of x.
fn abs(x) {
  if x >= 0 { x } else { 0 - x }
}

/// Returns the sign of x: 1, -1, or 0.
fn sign(x) {
  if x > 0 { 1 } else { if x < 0 { 0 - 1 } else { 0 } }
}

/// Returns the larger of a and b.
fn max(a, b) {
  if a >= b { a } else { b }
}

/// Returns the smaller of a and b.
fn min(a, b) {
  if a <= b { a } else { b }
}

/// Clamps x between lo and hi (inclusive).
fn clamp(x, lo, hi) {
  x |> max(lo) |> min(hi)
}

/// Returns x squared.
fn square(x) {
  x * x
}

/// Returns x cubed.
fn cube(x) {
  x * x * x
}

/// Returns base raised to exp (integer exponent).
fn pow(base, exp) {
  if exp <= 0 { 1 } else { base * pow(base, exp - 1) }
}

/// Returns the factorial of n (n!).
fn factorial(n) {
  if n <= 1 { 1 } else { n * factorial(n - 1) }
}

/// Returns true if x is even.
fn is_even(x) {
  mod(x, 2) == 0
}

/// Returns true if x is odd.
fn is_odd(x) {
  mod(x, 2) != 0
}

/// Returns the greatest common divisor of a and b.
fn gcd(a, b) {
  let x = abs(a)
  let y = abs(b)
  if y == 0 { x } else { gcd(y, mod(x, y)) }
}

/// Returns the sum of all elements in xs.
fn sum(xs) {
  xs |> reduce(0, fn(a, x) { a + x })
}

/// Returns the product of all elements in xs.
fn product(xs) {
  xs |> reduce(1, fn(a, x) { a * x })
}

/// Returns the integer average of xs.
fn average(xs) {
  let total = xs |> sum
  let count = xs |> length
  total / count
}

/// Returns the least common multiple of a and b.
fn lcm(a, b) {
  let g = gcd(a, b)
  if g == 0 { 0 } else { abs(a * b) / g }
}

/// Returns the nth Fibonacci number (iterative).
fn fib(n) {
  if n <= 0 { 0 } else {
    if n == 1 { 1 } else {
      let mut a = 0
      let mut b = 1
      let mut i = 2
      while i <= n {
        let tmp = a + b
        a = b
        b = tmp
        i = i + 1
      }
      b
    }
  }
}

/// Returns true if n is a prime number.
fn is_prime(n) {
  if n <= 1 { return false }
  if n <= 3 { return true }
  if mod(n, 2) == 0 { return false }
  let mut i = 3
  while i * i <= n {
    if mod(n, i) == 0 { return false }
    i = i + 2
  }
  true
}

/// Returns a list of all divisors of n.
fn divisors(n) {
  let x = abs(n)
  if x == 0 { return [] }
  let mut result = []
  let mut i = 1
  while i <= x {
    if mod(x, i) == 0 {
      result = push(result, i)
    }
    i = i + 1
  }
  result
}

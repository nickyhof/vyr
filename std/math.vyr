// std/math — Math utilities for Vyr
// Most functions are pure Vyr, using recursion and existing operators.

fn abs(x) {
  if x >= 0 { x } else { 0 - x }
}

fn sign(x) {
  if x > 0 { 1 } else { if x < 0 { 0 - 1 } else { 0 } }
}

fn max(a, b) {
  if a >= b { a } else { b }
}

fn min(a, b) {
  if a <= b { a } else { b }
}

fn clamp(x, lo, hi) {
  x |> max(lo) |> min(hi)
}

fn square(x) {
  x * x
}

fn cube(x) {
  x * x * x
}

fn pow(base, exp) {
  if exp <= 0 { 1 } else { base * pow(base, exp - 1) }
}

fn factorial(n) {
  if n <= 1 { 1 } else { n * factorial(n - 1) }
}

fn is_even(x) {
  mod(x, 2) == 0
}

fn is_odd(x) {
  mod(x, 2) != 0
}

fn gcd(a, b) {
  let x = abs(a)
  let y = abs(b)
  if y == 0 { x } else { gcd(y, mod(x, y)) }
}

fn sum(xs) {
  xs |> reduce(0, fn(a, x) { a + x })
}

fn product(xs) {
  xs |> reduce(1, fn(a, x) { a * x })
}

fn average(xs) {
  let total = xs |> sum
  let count = xs |> length
  total / count
}

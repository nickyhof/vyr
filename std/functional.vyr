// std/functional — Function composition utilities for Vyr

fn compose(f, g) {
  fn(x) { x |> f |> g }
}

fn pipe(fns) {
  reduce(fns, fn(x) { x }, fn(acc, f) {
    fn(x) { x |> acc |> f }
  })
}

fn identity(x) {
  x
}

fn constant(x) {
  fn() { x }
}

fn flip(f) {
  fn(a, b) { f(b, a) }
}

fn partial(f, x) {
  fn(y) { f(x, y) }
}

fn memoize(f) {
  let mut cache = #{}
  fn(x) {
    let key = to_string(x)
    if has_key(cache, key) {
      get(cache, key)
    } else {
      let result = f(x)
      cache = set(cache, key, result)
      result
    }
  }
}

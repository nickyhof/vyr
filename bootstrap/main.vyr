// main.vyr — Bootstrap Vyr compiler entry point
// Usage: vyrc <input.vyr> [output.go]
//
// Reads a Vyr source file, lexes → parses → generates Go code,
// then writes the output .go file.

import "bootstrap/lexer"
import "bootstrap/parser"
import "bootstrap/codegen"

fn resolve_imports(decls, imported) {
  let mut result = []
  let mut seen = imported
  let mut i = 0
  while i < length(decls) {
    let decl = index(decls, i)
    let dt = get(decl, "__type")
    if dt == "ImportDecl" {
      let path = decl.path + ".vyr"
      if has_key(seen, path) == false {
        seen = set(seen, path, true)
        let src = read_file(path)
        let toks = tokenize(src)
        let r = parse(toks)
        if get(r, "error") != "" {
          print("Import error (" + path + "): " + get(r, "error"))
          return result
        }
        let imported_prog = get(r, "node")
        let inner = resolve_imports(imported_prog.decls, seen)
        let mut j = 0
        while j < length(inner) {
          result = push(result, index(inner, j))
          j = j + 1
        }
      }
    } else {
      result = push(result, decl)
    }
    i = i + 1
  }
  result
}

fn main() {
  let argv = args()
  if length(argv) < 1 {
    print("Usage: vyrc <input.vyr> [output.go]")
    return
  }

  let input_file = index(argv, 0)

  // Determine output file: either explicit or replace .vyr with .go
  let output_file = if length(argv) > 1 {
    index(argv, 1)
  } else {
    if ends_with(input_file, ".vyr") {
      replace(input_file, ".vyr", ".go")
    } else {
      input_file + ".go"
    }
  }

  // Read source
  let source = read_file(input_file)

  // Lex
  let tokens = tokenize(source)

  // Parse
  let result = parse(tokens)
  if get(result, "error") != "" {
    print("Parse error: " + get(result, "error"))
    return
  }
  let prog = get(result, "node")

  // Resolve imports
  let resolved_decls = resolve_imports(prog.decls, #{})
  let resolved_prog = Program(resolved_decls)

  // Generate Go code
  let go_code = generate(resolved_prog)

  // Write output
  write_file(output_file, go_code)
  print("Compiled " + input_file + " -> " + output_file)
}


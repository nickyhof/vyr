{
  "name": "vyr",
  "displayName": "Vyr",
  "description": "Syntax highlighting for the Vyr programming language",
  "version": "0.1.0",
  "publisher": "nickyhof",
  "repository": {
    "type": "git",
    "url": "https://github.com/nickyhof/vyr"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "vyr",
        "aliases": ["Vyr", "vyr"],
        "extensions": [".vyr"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "vyr",
        "scopeName": "source.vyr",
        "path": "./syntaxes/vyr.tmLanguage.json"
      }
    ]
  }
}

// stdlib_expanded.vyr — Exercising all new stdlib functions

import "std/math"
import "std/string"
import "std/collections"
import "std/result"
import "std/functional"

fn main() {
  print("=== Math ===")
  lcm(4, 6) |> print                     // 12
  fib(10) |> print                        // 55
  is_prime(17) |> print                   // true
  is_prime(15) |> print                   // false
  divisors(12) |> print                   // [1, 2, 3, 4, 6, 12]

  print("")
  print("=== String ===")
  "hello\nworld\nfoo" |> lines |> print   // [hello, world, foo]
  ["hello", "world"] |> unwords |> print  // hello world
  ["a", "b", "c"] |> unlines |> print     // a\nb\nc
  "hello world" |> title_case |> print    // Hello World
  "helloWorld" |> snake_case |> print     // hello_world
  "helloWorld" |> kebab_case |> print     // hello-world
  strip_prefix("/api/users", "/api") |> print  // /users
  strip_suffix("file.txt", ".txt") |> print    // file
  truncate("hello world", 5, "...") |> print   // hello...
  count_occurrences("banana", "an") |> print   // 2
  is_digit("5") |> print                  // true
  is_alpha("a") |> print                  // true
  is_digit("x") |> print                  // false

  print("")
  print("=== Collections ===")
  let nums = [1, 2, 3, 4, 5, 6]
  nums |> group_by(fn(x) { if mod(x, 2) == 0 { "even" } else { "odd" } }) |> print
  nums |> partition(fn(x) { x > 3 }) |> print   // [[4, 5, 6], [1, 2, 3]]
  nums |> scan(0, fn(a, x) { a + x }) |> print  // [0, 1, 3, 6, 10, 15, 21]
  [1, 2, 3, 4, 5] |> window(3) |> print         // [[1,2,3], [2,3,4], [3,4,5]]
  ["a", "b", "a", "c", "b", "a"] |> frequencies |> print  // #{a: 3, b: 2, c: 1}
  index_of([10, 20, 30], 20) |> print    // 1
  index_of([10, 20, 30], 99) |> print    // -1

  let a = [1, 2, 3]
  let b = [10, 20, 30]
  zip_with(a, b, fn(x, y) { x + y }) |> print    // [11, 22, 33]
  interleave([1, 2, 3], ["a", "b", "c"]) |> print // [1, a, 2, b, 3, c]

  // sort_by: sort strings by length
  ["banana", "fig", "apple", "kiwi"] |> sort_by(fn(s) { length(s) }) |> print

  print("")
  print("=== Result ===")
  let results = [ok(1), ok(2), ok(3)]
  collect_results(results) |> result_to_string |> print  // Ok([1, 2, 3])

  let bad = [ok(1), err("fail"), ok(3)]
  collect_results(bad) |> result_to_string |> print      // Err(fail)

  ok(42) |> tap_ok(fn(v) { print("got: " + to_string(v)) }) |> result_to_string |> print
  err("oops") |> tap_err(fn(e) { print("error: " + e) }) |> result_to_string |> print

  print("")
  print("=== Functional ===")
  let double = fn(x) { x * 2 }
  let inc = fn(x) { x + 1 }

  let double_then_inc = compose(double, inc)
  double_then_inc(5) |> print              // 11

  let pipeline = pipe([double, inc, double])
  pipeline(3) |> print                     // 14

  identity(42) |> print                    // 42

  let always_hello = constant("hello")
  always_hello() |> print                  // hello

  let sub = fn(a, b) { a - b }
  let flipped_sub = flip(sub)
  flipped_sub(3, 10) |> print             // 7

  let add10 = partial(fn(a, b) { a + b }, 10)
  add10(5) |> print                        // 15

  let slow_square = memoize(fn(x) { x * x })
  slow_square(7) |> print                  // 49
  slow_square(7) |> print                  // 49 (cached)

  print("")
  print("All stdlib tests passed!")
}
